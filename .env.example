# Development-only example. Production rejects defaults and auto-bootstrap.
APP_ENV=development
POSTGRES_PASSWORD=alpha-local-only
SECRET_KEY=local-alpha-change-me
EXPECTED_DATABASE_REVISION=integration_41_merge_0001
QUERY_ENGINE_MODE=SHADOW
SQLBOT_INCLUDED_IN_V4_RELEASE=false
SQLBOT_ENGINE_ENABLED=false
SQLBOT_RUNTIME_VERIFIED=false
MEMORY_LIFECYCLE_SCHEDULER_ENABLED=true
MEMORY_LIFECYCLE_INTERVAL_SECONDS=30
MEMORY_LIFECYCLE_BATCH_SIZE=20
MEMORY_LIFECYCLE_REDIS_ENABLED=true
MEMORY_LIFECYCLE_SCENARIO_IDS=charging_ops,sales_ops
AUTO_BOOTSTRAP_DEMO_USERS=true
CHATBI_PG_PASSWORD=
CHATBI_MYSQL_PASSWORD=
