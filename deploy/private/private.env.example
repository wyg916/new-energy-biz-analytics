# Copy to deploy/private/private.env and replace every placeholder.
# This example is for a single-customer, single-host release candidate using simulated data.
POSTGRES_DB=renewable_private
POSTGRES_USER=renewable
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://renewable:replace-with-a-strong-database-password@db:5432/renewable_private
SECRET_KEY=replace-with-at-least-32-random-characters

PUBLIC_HOST=analytics.example.internal
PUBLIC_BASE_URL=https://analytics.example.internal
CORS_ORIGINS=https://analytics.example.internal
TRUSTED_HOSTS=analytics.example.internal

RELEASE_VERSION=0.6.0-rc1
EXPECTED_DATABASE_REVISION=0011
PLATFORM_VERSION_ROUTING_ENABLED=false
QUERY_ENGINE_MODE=DETERMINISTIC_ONLY
CHATBI_READONLY_EXECUTION_ENABLED=false
CHATBI_READONLY_DATABASE_URL=
CHATBI_STATEMENT_TIMEOUT_MS=5000
API_IMAGE=renewable-operations-private-api
WEB_IMAGE=renewable-operations-private-web
API_SOURCE_ALLOWLIST=localhost,127.0.0.1

# Directory must contain tls.crt and tls.key. Do not commit this directory.
TLS_DIR=./runtime/tls
HTTP_PORT=80
HTTPS_PORT=443
