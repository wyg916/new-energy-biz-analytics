          "title": "2026年6月区域城市收入毛利分析",
          "sql": "SELECT \"st\".\"region_id\" AS \"region_id\", \"st\".\"city_id\" AS \"city_id\", SUM(\"s\".\"electricity_fee_net_amount\" + \"s\".\"service_fee_net_amount\") AS \"charging_revenue\", COUNT(DISTINCT \"s\".\"session_id\") AS \"completed_order_count\", SUM(\"s\".\"electricity_fee_net_amount\" + \"s\".\"service_fee_net_amount\") - SUM(COALESCE(\"ec\".\"energy_cost\", 0)) - SUM(COALESCE(\"oe\".\"amount\", 0)) AS \"gross_profit\" FROM \"semantic_sqlbot_charging\".\"fact_charging_session\" \"s\" JOIN \"semantic_sqlbot_charging\".\"dim_station\" \"st\" ON \"s\".\"station_id\" = \"st\".\"station_id\" LEFT JOIN (SELECT \"e\".\"station_id\" AS \"station_id\", SUM(\"e\".\"energy_cost\") AS \"energy_cost\" FROM \"semantic_sqlbot_charging\".\"fact_energy_cost\" \"e\" WHERE \"e\".\"cost_date\" >= DATE '2026-06-01' AND \"e\".\"cost_date\" < DATE '2026-07-01' GROUP BY \"e\".\"station_id\") \"ec\" ON \"ec\".\"station_id\" = \"st\".\"station_id\" LEFT JOIN (SELECT \"o\".\"station_id\" AS \"station_id\", SUM(\"o\".\"amount\") AS \"amount\" FROM \"semantic_sqlbot_charging\".\"fact_operation_expense\" \"o\" WHERE \"o\".\"is_variable\" = TRUE AND \"o\".\"expense_date\" >= DATE '2026-06-01' AND \"o\".\"expense_date\" < DATE '2026-07-01' GROUP BY \"o\".\"station_id\") \"oe\" ON \"oe\".\"station_id\" = \"st\".\"station_id\" WHERE \"s\".\"settlement_time\" >= TIMESTAMP '2026-06-01 00:00:00' AND \"s\".\"settlement_time\" < TIMESTAMP '2026-07-01 00:00:00' GROUP BY \"st\".\"region_id\", \"st\".\"city_id\" ORDER BY \"st\".\"region_id\", \"st\".\"city_id\" LIMIT 500"
