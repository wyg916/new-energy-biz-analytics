      "sqlbot_session_created": true,
      "generated_sql": "SELECT \"st\".\"region_id\" AS \"region_id\", \"st\".\"city_id\" AS \"city_id\", SUM(\"s\".\"electricity_fee_net_amount\" + \"s\".\"service_fee_net_amount\") AS \"charging_revenue\", COUNT(DISTINCT \"s\".\"session_id\") AS \"completed_order_count\", SUM(\"s\".\"electricity_fee_net_amount\" + \"s\".\"service_fee_net_amount\") - SUM(COALESCE(\"ec\".\"energy_cost\", 0)) - SUM(COALESCE(\"oe\".\"amount\", 0)) AS \"gross_profit\" FROM \"fact_charging_session\" AS \"s\" JOIN \"dim_station\" AS \"st\" ON \"s\".\"station_id\" = \"st\".\"station_id\" LEFT JOIN (SELECT \"e\".\"station_id\" AS \"station_id\", SUM(\"e\".\"energy_cost\") AS \"energy_cost\" FROM \"fact_energy_cost\" AS \"e\" WHERE \"e\".\"cost_date\" >= CAST('2026-06-01' AS DATE) AND \"e\".\"cost_date\" < CAST('2026-07-01' AS DATE) GROUP BY \"e\".\"station_id\") AS \"ec\" ON \"ec\".\"station_id\" = \"st\".\"station_id\" LEFT JOIN (SELECT \"o\".\"station_id\" AS \"station_id\", SUM(\"o\".\"amount\") AS \"amount\" FROM \"fact_operation_expense\" AS \"o\" WHERE \"o\".\"is_variable\" = TRUE AND \"o\".\"expense_date\" >= CAST('2026-06-01' AS DATE) AND \"o\".\"expense_date\" < CAST('2026-07-01' AS DATE) GROUP BY \"o\".\"station_id\") AS \"oe\" ON \"oe\".\"station_id\" = \"st\".\"station_id\" WHERE \"s\".\"settlement_time\" >= CAST('2026-06-01 00:00:00' AS TIMESTAMP) AND \"s\".\"settlement_time\" < CAST('2026-07-01 00:00:00' AS TIMESTAMP) GROUP BY \"st\".\"region_id\", \"st\".\"city_id\" ORDER BY \"st\".\"region_id\", \"st\".\"city_id\" LIMIT 500",
