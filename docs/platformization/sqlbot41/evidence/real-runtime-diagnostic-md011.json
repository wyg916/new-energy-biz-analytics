          "title": "2026年6月区域渠道收入订单毛利分析",
          "sql": "SELECT \"r\".\"region_name\" AS \"region_name\", \"c\".\"channel_name\" AS \"channel_name\", SUM(\"o\".\"net_revenue\") AS \"total_revenue\", COUNT(DISTINCT \"o\".\"order_id\") AS \"total_orders\", SUM(\"o\".\"gross_profit\") AS \"total_gross_profit\" FROM \"semantic_sqlbot_sales\".\"sales_order\" \"o\" JOIN \"semantic_sqlbot_sales\".\"sales_region\" \"r\" ON \"o\".\"region_id\" = \"r\".\"region_id\" JOIN \"semantic_sqlbot_sales\".\"sales_channel\" \"c\" ON \"o\".\"channel_id\" = \"c\".\"channel_id\" WHERE \"o\".\"order_date\" >= DATE '2026-06-01' AND \"o\".\"order_date\" < DATE '2026-07-01' GROUP BY \"r\".\"region_name\", \"c\".\"channel_name\" ORDER BY \"r\".\"region_name\", \"c\".\"channel_name\" LIMIT 500"
